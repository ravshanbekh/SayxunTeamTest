# Serverda: cp .env.example .env  va qiymatlarni to'ldiring.
# .env fayli git'ga qo'shilmaydi (.gitignore).

# Domen (A yozuvi Contabo server IP manziliga qaratilgan bo'lishi kerak)
DOMAIN=test.example.uz

# Telegram bot tokeni (@BotFather)
BOT_TOKEN=

# PostgreSQL
POSTGRES_USER=testplatform
POSTGRES_DB=testing_platform
# Kuchli parol: openssl rand -hex 24
POSTGRES_PASSWORD=

# JWT kaliti: openssl rand -hex 32
SECRET_KEY=

# Ixtiyoriy
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SESSION_DURATION_MINUTES=90
CORS_ORIGINS=*
# Rasch ballini yuqoridan cheklash (bo'sh - cheklanmaydi; masalan 75)
RASCH_MAX_SCORE=
